/* ===== Variabel ===== */
:root {
    --red: #e31b23;
    --red-dark: #c81e1e;
    --pink: #fde8e8;
    --border: #e5e7eb;
    --text: #111827;
    --muted: #6b7280;

    --sidebar-w: 310px;
    --navbar-h: 74px;
}

/* ===== Reset ===== */
*,
*::before,
*::after {
    box-sizing: border-box;
}
body {
    margin: 0;
    font-family: "Inter", system-ui, sans-serif;
    color: var(--text);
    background: #fff;
    -webkit-font-smoothing: antialiased;
}
a {
    color: inherit;
    text-decoration: none;
}
button {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
}
input {
    font: inherit;
}
img,
svg {
    display: block;
}
strong,
small {
    display: block;
}

/* Semua ikon: garis outline */
svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
}

/* ===== Sidebar ===== */
.sidebar {
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    z-index: 40;
    width: var(--sidebar-w);
    background: #fff;
    border-right: 1px solid var(--border);
    transform: translateX(-100%);
    transition: transform 0.2s ease;
}
.sidebar.is-open {
    transform: none;
}

.sidebar_logo {
    display: block;
    height: 120px;
    padding: 24px 0 0 82px; /* logo sedikit ke kiri dari tengah, seperti di desain */
}
.sidebar_logo img {
    height: 72px;
    width: auto;
}

.sidebar_nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 13px 12px 0 11px;
}

.sidebar_link {
    display: flex;
    align-items: center;
    gap: 17px;
    height: 47px;
    padding-left: 23px;
    border-radius: 10px;
    font-size: 20px;
    font-weight: 400;
    color: #1f2937;
    transition:
        background-color 0.15s,
        color 0.15s;
}
.sidebar_link svg {
    width: 25px;
    height: 25px;
    flex-shrink: 0;
}
.sidebar_link:hover {
    background: #fef2f2;
    color: var(--red);
}
.sidebar_link.is-active {
    background: var(--pink);
    color: var(--red);
    font-weight: 700;
}

/* ===== Halaman ===== */
.page {
    min-height: 100vh;
}
.content {
    padding: 12px 22px 24px;
}

.overlay {
    position: fixed;
    inset: 0;
    z-index: 30;
    background: rgba(0, 0, 0, 0.4);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s;
}
.overlay.is-open {
    opacity: 1;
    visibility: visible;
}

/* ===== Navbar ===== */
.navbar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 16px;
    height: var(--navbar-h);
    padding: 0 30px 0 22px;
    background: #fff;
    border-bottom: 1px solid var(--border);
}

.navbar_toggle {
    display: none;
    padding: 6px;
    border-radius: 8px;
}
.navbar_toggle:hover {
    background: #f3f4f6;
}
.navbar_toggle svg {
    width: 24px;
    height: 24px;
}

/* Search */
.search {
    position: relative;
    width: 100%;
    max-width: 338px;
}
.search_icon {
    position: absolute;
    left: 10px;
    top: 50%;
    width: 14px;
    height: 14px;
    transform: translateY(-50%);
    color: var(--red);
    stroke-width: 2;
    pointer-events: none;
}
.search_input {
    width: 100%;
    height: 28px;
    padding: 0 10px 0 30px;
    font-size: 10px;
    color: #374151;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 5px;
}
.search_input::placeholder {
    color: #9ca3af;
}
.search_input:focus {
    outline: none;
    border-color: #f87171;
    box-shadow: 0 0 0 3px #fee2e2;
}

/* Kanan */
.navbar_right {
    display: flex;
    align-items: center;
    gap: 30px;
    margin-left: auto;
}

.bell {
    position: relative;
    width: 20px;
    height: 20px;
    color: #1f2937;
}
.bell svg {
    width: 18px;
    height: 18px;
}
.bell_dot {
    position: absolute;
    top: -1px;
    right: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--red);
}

.profile {
    display: flex;
    align-items: center;
    gap: 8px;
}
.profile_avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--text);
    color: #fff;
}
.profile_avatar svg {
    width: 13px;
    height: 13px;
    fill: currentColor;
    stroke: none;
}
.profile_info {
    text-align: left;
    line-height: 1.3;
}
.profile_info strong {
    font-size: 10px;
    font-weight: 700;
}
.profile_info small {
    font-size: 8px;
    color: var(--muted);
}
.profile_chevron {
    width: 12px;
    height: 12px;
    margin-left: 14px;
    color: #6b7280;
}

/* ===== Desktop: sidebar selalu tampil ===== */
@media (min-width: 1024px) {
    .sidebar {
        transform: none;
    }
    .overlay {
        display: none;
    }
    .page {
        padding-left: var(--sidebar-w);
    }
}

/* ===== Mobile / tablet ===== */
@media (max-width: 1023px) {
    .navbar_toggle {
        display: block;
    }
    .navbar {
        padding: 0 16px;
    }
    .navbar_right {
        gap: 18px;
    }
}
@media (max-width: 599px) {
    .profile_info,
    .profile_chevron {
        display: none;
    }
}
